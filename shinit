if [ -d "${HOME}/.commonsh" ] ; then
    for file in "${HOME}"/.commonsh/* ; do
        . "${file}"
    done
fi

if [ -d "${HOME}/.sh" ] ; then
    for file in "${HOME}"/.sh/* ; do
        . "${file}"
    done
fi

# Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
export PATH="$PATH:$HOME/.rvm/bin"
